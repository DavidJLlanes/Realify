# Informe de errores de Realify. Dos trozos:
#
# 1) En el contexto `http { … }` (p. ej. /etc/nginx/conf.d/realify-informe.conf):
limit_req_zone $binary_remote_addr zone=informe:10m rate=2r/m;

# 2) DENTRO del bloque `server { … }` de realify.es (443), junto a los demás `location`:
location = /api/informe {
    limit_except POST { deny all; }
    limit_req          zone=informe burst=3 nodelay;
    limit_req_status   429;
    client_max_body_size 700k;
    proxy_pass         http://127.0.0.1:8766;
    proxy_http_version 1.1;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   Connection "";
    proxy_read_timeout 25s;
    proxy_request_buffering on;
}
location ^~ /api/ { return 404; }     # nada más cuelga de /api
