# ════════════════════════════════════════════════════════════════
#  Configuración de Nginx para el servicio Panorama de Realify
#  Añadir dentro del bloque `server { ... }` HTTPS de realify.es:
# ════════════════════════════════════════════════════════════════

# En el contexto `http { … }`: máximo 4 peticiones por minuto y por IP.
limit_req_zone $binary_remote_addr zone=stitch:10m rate=4r/m;

location = /api/stitch {
    limit_except POST { deny all; }
    limit_req          zone=stitch burst=2 nodelay;
    limit_req_status   429;
    proxy_pass http://127.0.0.1:8767/stitch;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    # Permitir subir ráfagas de fotos de alta resolución
    client_max_body_size 120m;
    proxy_request_buffering on;

    # Procesar SIFT/Bundle adjustment puede llevar decenas de segundos
    proxy_connect_timeout 60s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
}
